# Copy only into an authorized NAS deployment or isolated test location; chmod 600.
# Required: a newly generated URL-safe random password (e.g. random hex).
# This value is used verbatim both by PostgreSQL and inside the connection URI.
POSTGRES_PASSWORD=

# Required: actual full commit SHA; production must be merged main.
DH_CODE_VERSION=

# Explicit NAS interface addresses only: never 0.0.0.0, :: or an empty binding.
CATALOG_LAN_IP=192.0.2.10
CATALOG_TAILSCALE_IP=192.0.2.20
DH_V0_URL=http://192.0.2.10:8503
DH_V0_PUBLIC_URL=http://192.0.2.10:8503

# Do not put AUTH_SECRET / AUTH_USER / AUTH_PASS here.
# Authentication reads only the read-only /run/v0.env supplied by v0.
