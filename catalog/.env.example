# Copy only into an authorized deployment or isolated test location; chmod 600.
# Required: a newly generated URL-safe random password (e.g. random hex).
# This value is used verbatim both by PostgreSQL and inside the connection URI.
POSTGRES_PASSWORD=

# Required: actual full commit SHA; production must be merged main.
DH_CODE_VERSION=

# Required: explicit host interface addresses, never wildcard or empty bindings.
CATALOG_LAN_IP=
CATALOG_TAILSCALE_IP=
# Required: full HTTP(S) URL reachable from the catalog API container.
DH_V0_URL=
# Optional: browser-facing URL; empty or omitted reuses the explicit DH_V0_URL.
DH_V0_PUBLIC_URL=

# Required: absolute host paths supplied by the deployment operator.
# The first four inputs are read-only; PGDATA must be outside the source checkout.
# These are NOT the container DH_DATA_DIR / DH_BACKUP_DIR scan roots.
DH_HOST_DATA_DIR=
DH_HOST_BACKUP_DIR=
DH_HOST_CACHE_DIR=
DH_HOST_V0_ENV_FILE=
DH_HOST_PGDATA_DIR=

# Optional: old absolute POSIX roots appearing inside execution records.
# These may differ from the current host mounts; no files are opened through them.
# Empty means only /data/, /backup/ and relative record paths are recognized.
DH_RECORD_DATA_ROOT=
DH_RECORD_BACKUP_ROOT=

# Do not put AUTH_SECRET / AUTH_USER / AUTH_PASS here.
# Authentication reads only the read-only /run/v0.env supplied by v0.
